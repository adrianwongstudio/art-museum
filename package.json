{
  "name": "art-museum",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A first-person 3D art gallery. Walk up to the work, learn about it, inquire.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "art": "node scripts/generate-placeholder-art.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
